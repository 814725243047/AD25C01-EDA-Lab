import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Load Titanic dataset
df = sns.load_dataset("titanic")

# Create 2x3 subplot layout
fig, axes = plt.subplots(2, 3, figsize=(16, 9))

# 1. Histogram - Age distribution
sns.histplot(
    df["age"].dropna(),
    kde=True,
    ax=axes[0, 0],
    color="steelblue"
)
axes[0, 0].set_title("Distribution of Passenger Age")

# 2. Bar chart - Survival rate by class
sns.barplot(
    x="class",
    y="survived",
    data=df,
    ax=axes[0, 1],
    palette="viridis"
)
axes[0, 1].set_title("Survival Rate by Passenger Class")

# 3. Box plot - Fare by class
sns.boxplot(
    x="class",
    y="fare",
    data=df,
    ax=axes[0, 2],
    palette="Set2"
)
axes[0, 2].set_title("Fare Distribution by Class (Outliers)")

# 4. Scatter plot - Age vs Fare
sns.scatterplot(
    x="age",
    y="fare",
    hue="survived",
    data=df,
    ax=axes[1, 0]
)
axes[1, 0].set_title("Age vs Fare (Colored by Survival)")

# 5. Heatmap - Correlation matrix
numeric_df = df.select_dtypes(include="number")

sns.heatmap(
    numeric_df.corr(),
    annot=True,
    cmap="coolwarm",
    ax=axes[1, 1]
)
axes[1, 1].set_title("Correlation Heatmap")

# 6. Count plot - Passengers by embarkation town
sns.countplot(
    x="embark_town",
    data=df,
    ax=axes[1, 2],
    palette="pastel"
)
axes[1, 2].set_title("Passengers by Embarkation Town")

# Adjust layout
plt.tight_layout()

# Save the figure
plt.savefig("data_story.png", dpi=150)

# Display the plots
plt.show()
